# Is file ko copy karke ".env.local" naam do aur asli values bharo.
# Asli keys kabhi GitHub par mat daalo.

# Phase 2 mein chahiye (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SIRF server ke liye. NEXT_PUBLIC_ kabhi mat lagana.
SUPABASE_SERVICE_ROLE_KEY=

# Contact page par dikhne wala email
NEXT_PUBLIC_CONTACT_EMAIL=

# Telegram Bind + Referral. BotFather (@BotFather) se Bot banane par milenge.
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Khud socho, random lamba string (jaise: openssl rand -hex 20). setWebhook mein isi secret_token ka use hoga.
TELEGRAM_WEBHOOK_SECRET=

# Full-Site Lock Gate (naya) — tumhara apna Telegram Channel/Group
# Numeric Channel ID (jaise -1001234567890). Channel ka koi msg @getidsbot ya @username_to_id_bot ko forward karke milega.
TELEGRAM_CHANNEL_ID=
# Channel ka join link (public ho to https://t.me/channelusername, private ho to Invite Link)
NEXT_PUBLIC_TELEGRAM_CHANNEL_LINK=
# Tumhari site ka pura URL (Telegram bot ke "Open App" button ke liye)
NEXT_PUBLIC_SITE_URL=https://studyuniverse.vercel.app
# Kitne "Active Referrals" chahiye site unlock karne ke liye (default 1)
REFERRAL_QUOTA=1
