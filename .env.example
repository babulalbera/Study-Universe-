# Is file ko copy karke ".env.local" naam do aur asli values bharo.
# Asli keys kabhi GitHub par mat daalo.

# Phase 2 mein chahiye (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SIRF server ke liye. NEXT_PUBLIC_ kabhi mat lagana.
SUPABASE_SERVICE_ROLE_KEY=

# Contact page par dikhne wala email
NEXT_PUBLIC_CONTACT_EMAIL=
